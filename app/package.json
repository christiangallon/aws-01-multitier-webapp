{
  "name": "aws-multitier-webapp",
  "version": "1.0.0",
  "description": "Node.js/Express application tier for the AWS multi-tier web app (EC2 + RDS MySQL + S3 + CloudWatch).",
  "main": "src/server.js",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
