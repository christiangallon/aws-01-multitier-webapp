###############################################################################
# AWS Multi-Tier Web App — root module
#
# Wires together: VPC -> Security Groups -> S3 -> RDS -> IAM -> EC2 (ALBs/ASGs)
# -> CloudWatch. The Node.js application in ../app is packaged and uploaded to
# the artifacts bucket by Terraform so the very first `apply` produces a fully
# working stack; later releases can be pushed with ../scripts/deploy.sh.
###############################################################################

terraform {
  required_version = ">= 1.5.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = ">= 5.40.0, < 6.0.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
    archive = {
      source  = "hashicorp/archive"
      version = "~> 2.4"
    }
  }

  # Partial configuration: values are supplied by backend.hcl, which is
  # generated by ../scripts/init-backend.sh:
  #   terraform init -backend-config=backend.hcl
  backend "s3" {}
}

provider "aws" {
  region = var.aws_region

  default_tags {
    tags = merge(
      {
        Project     = var.project_name
        Environment = var.environment
        ManagedBy   = "terraform"
        Repository  = "christiangallon/aws-01-multitier-webapp"
      },
      var.extra_tags
    )
  }
}

data "aws_caller_identity" "current" {}

data "aws_availability_zones" "available" {
  state = "available"
}

resource "random_id" "suffix" {
  byte_length = 3
}

locals {
  name_prefix = "${var.project_name}-${var.environment}"

  # Bucket names must be globally unique and <= 63 chars.
  bucket_prefix = substr("${local.name_prefix}-${random_id.suffix.hex}", 0, 45)

  azs = length(var.availability_zones) > 0 ? var.availability_zones : slice(data.aws_availability_zones.available.names, 0, 2)

  app_dir        = "${path.module}/../app"
  app_bundle_key = "releases/app.zip"

  static_dir   = "${local.app_dir}/public"
  static_files = fileset(local.static_dir, "**")

  content_types = {
    html = "text/html; charset=utf-8"
    css  = "text/css; charset=utf-8"
    js   = "application/javascript; charset=utf-8"
    json = "application/json"
    png  = "image/png"
    jpg  = "image/jpeg"
    jpeg = "image/jpeg"
    gif  = "image/gif"
    svg  = "image/svg+xml"
    ico  = "image/x-icon"
    txt  = "text/plain; charset=utf-8"
  }
}

###############################################################################
# Networking
###############################################################################

module "vpc" {
  source = "./modules/vpc"

  name_prefix          = local.name_prefix
  vpc_cidr             = var.vpc_cidr
  availability_zones   = local.azs
  public_subnet_cidrs  = var.public_subnet_cidrs
  private_subnet_cidrs = var.private_subnet_cidrs
}

module "security_groups" {
  source = "./modules/security_groups"

  name_prefix = local.name_prefix
  vpc_id      = module.vpc.vpc_id
  admin_cidr  = var.admin_cidr
  app_port    = var.app_port
}

###############################################################################
# Storage
###############################################################################

module "s3" {
  source = "./modules/s3"

  bucket_prefix = local.bucket_prefix
  force_destroy = var.s3_force_destroy
}

# Package the Node.js application (without node_modules / local env files).
data "archive_file" "app_bundle" {
  type        = "zip"
  source_dir  = local.app_dir
  output_path = "${path.module}/.build/app.zip"
  excludes = [
    "node_modules",
    "node_modules/**",
    ".env",
    "coverage",
    "coverage/**",
  ]
}

resource "aws_s3_object" "app_bundle" {
  bucket       = module.s3.artifacts_bucket_id
  key          = local.app_bundle_key
  source       = data.archive_file.app_bundle.output_path
  source_hash  = data.archive_file.app_bundle.output_md5
  content_type = "application/zip"
}

resource "aws_s3_object" "static_assets" {
  for_each = local.static_files

  bucket       = module.s3.static_assets_bucket_id
  key          = each.value
  source       = "${local.static_dir}/${each.value}"
  source_hash  = filemd5("${local.static_dir}/${each.value}")
  content_type = lookup(local.content_types, lower(element(split(".", each.value), length(split(".", each.value)) - 1)), "application/octet-stream")
}

###############################################################################
# Data tier
###############################################################################

module "rds" {
  source = "./modules/rds"

  name_prefix                    = local.name_prefix
  private_subnet_ids             = module.vpc.private_subnet_ids
  rds_security_group_id          = module.security_groups.rds_sg_id
  instance_class                 = var.db_instance_class
  allocated_storage              = var.db_allocated_storage
  multi_az                       = var.db_multi_az
  db_name                        = var.db_name
  db_username                    = var.db_username
  backup_retention_period        = var.db_backup_retention_days
  secret_recovery_window_in_days = var.secret_recovery_window_in_days
}

###############################################################################
# Identity
###############################################################################

module "iam" {
  source = "./modules/iam"

  name_prefix              = local.name_prefix
  artifacts_bucket_arn     = module.s3.artifacts_bucket_arn
  static_assets_bucket_arn = module.s3.static_assets_bucket_arn
  db_secret_arn            = module.rds.db_secret_arn
}

###############################################################################
# Compute (ALBs, launch templates, auto scaling groups)
###############################################################################

module "ec2" {
  source = "./modules/ec2"

  name_prefix        = local.name_prefix
  aws_region         = var.aws_region
  environment        = var.environment
  vpc_id             = module.vpc.vpc_id
  public_subnet_ids  = module.vpc.public_subnet_ids
  private_subnet_ids = module.vpc.private_subnet_ids

  alb_sg_id          = module.security_groups.alb_sg_id
  internal_alb_sg_id = module.security_groups.internal_alb_sg_id
  web_sg_id          = module.security_groups.web_sg_id
  app_sg_id          = module.security_groups.app_sg_id
  bastion_sg_id      = module.security_groups.bastion_sg_id

  instance_profile_name = module.iam.instance_profile_name

  web_instance_type = var.web_instance_type
  app_instance_type = var.app_instance_type
  web_min_size      = var.web_min_size
  web_max_size      = var.web_max_size
  web_desired       = var.web_desired_capacity
  app_min_size      = var.app_min_size
  app_max_size      = var.app_max_size
  app_desired       = var.app_desired_capacity
  app_port          = var.app_port

  artifacts_bucket     = module.s3.artifacts_bucket_id
  static_assets_bucket = module.s3.static_assets_bucket_id
  app_bundle_key       = aws_s3_object.app_bundle.key
  app_bundle_version   = data.archive_file.app_bundle.output_md5
  # Derived from the uploaded objects: creates an implicit dependency (files
  # exist before web instances boot) and rolls the web tier when they change.
  static_version = md5(join(",", [for k in sort(keys(aws_s3_object.static_assets)) : aws_s3_object.static_assets[k].source_hash]))

  db_host       = module.rds.db_address
  db_port       = module.rds.db_port
  db_name       = module.rds.db_name
  db_secret_arn = module.rds.db_secret_arn

  app_log_group_name = module.cloudwatch.app_log_group_name
  web_log_group_name = module.cloudwatch.web_log_group_name

  enable_alb_access_logs = var.enable_alb_access_logs
  access_logs_bucket     = module.s3.access_logs_bucket_id

  enable_bastion   = var.enable_bastion
  bastion_key_name = var.bastion_key_name
}

###############################################################################
# Monitoring
###############################################################################

module "cloudwatch" {
  source = "./modules/cloudwatch"

  name_prefix        = local.name_prefix
  aws_region         = var.aws_region
  alarm_email        = var.alarm_email
  log_retention_days = var.log_retention_days

  web_asg_name                = module.ec2.web_asg_name
  app_asg_name                = module.ec2.app_asg_name
  alb_arn_suffix              = module.ec2.alb_arn_suffix
  web_target_group_arn_suffix = module.ec2.web_target_group_arn_suffix
  internal_alb_arn_suffix     = module.ec2.internal_alb_arn_suffix
  app_target_group_arn_suffix = module.ec2.app_target_group_arn_suffix
  rds_instance_id             = module.rds.db_instance_id
}
