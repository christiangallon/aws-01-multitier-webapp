#!/bin/bash
set -euxo pipefail
dnf install -y python3 python3-pip
mkdir -p /opt/multitier
cat > /opt/multitier/app.py <<'PYAPP'
import json, os, urllib.parse
from http.server import BaseHTTPRequestHandler, HTTPServer
import boto3
import pymysql

class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == '/health':
            return self.respond(200, {'status':'ok'})
        if self.path == '/':
            return self.respond(200, {'service':'AWS Multi-Tier Web App','endpoints':['/health','/db','/s3']})
        if self.path == '/db':
            try:
                connection = pymysql.connect(host=os.environ['DB_HOST'], user=os.environ['DB_USER'], password=os.environ['DB_PASSWORD'], database='appdb', connect_timeout=5)
                with connection.cursor() as cursor:
                    cursor.execute('SELECT VERSION()')
                    version = cursor.fetchone()[0]
                connection.close()
                return self.respond(200, {'database':'connected','mysql_version':version})
            except Exception as exc:
                print('Database check failed:', type(exc).__name__, flush=True)
                return self.respond(503, {'database':'unavailable'})
        if self.path == '/s3':
            try:
                key='healthcheck/status.json'
                s3=boto3.client('s3', region_name=os.environ['AWS_REGION'])
                s3.put_object(Bucket=os.environ['BUCKET'], Key=key, Body=json.dumps({'status':'ok'}), ContentType='application/json')
                obj=s3.get_object(Bucket=os.environ['BUCKET'], Key=key)
                return self.respond(200, {'storage':'connected','object':key,'result':json.loads(obj['Body'].read())})
            except Exception as exc:
                print('S3 check failed:', type(exc).__name__, flush=True)
                return self.respond(503, {'storage':'unavailable'})
        return self.respond(404, {'error':'not found'})
    def respond(self, code, payload):
        body=json.dumps(payload).encode()
        self.send_response(code)
        self.send_header('Content-Type','application/json')
        self.send_header('Content-Length',str(len(body)))
        self.end_headers()
        self.wfile.write(body)
HTTPServer(('0.0.0.0',80),Handler).serve_forever()
PYAPP
python3 -m pip install --break-system-packages boto3 pymysql
cat > /etc/systemd/system/multitier.service <<'UNIT'
[Unit]
Description=AWS Multi Tier Demo
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
EnvironmentFile=/etc/multitier.env
ExecStart=/usr/bin/python3 /opt/multitier/app.py
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
UNIT
cat > /etc/multitier.env <<'ENV'
DB_HOST=${db_host}
DB_USER=${db_user}
DB_PASSWORD=${db_password}
BUCKET=${bucket}
AWS_REGION=${region}
ENV
chmod 600 /etc/multitier.env
systemctl daemon-reload
systemctl enable --now multitier
